# Copy to .env and fill in. Nothing here is required for plain local dev — the defaults
# already assume Ollama is running on this machine at its default address.

# Only needed once you point this at something other than your own machine (a tunnel, a
# hosted Ollama box). See ../backend/README.md.
# OLLAMA_HOST=https://your-tunnel-url.trycloudflare.com

# Only needed if OLLAMA_HOST requires one.
# OLLAMA_API_KEY=

# Defaults to qwen2.5:7b.
# OLLAMA_MODEL=qwen2.5:7b

# Comma-separated. Defaults to open (fine for local dev).
# CHAT_ALLOWED_ORIGINS=http://localhost:5173

# Defaults to 3003.
# PORT=3003
