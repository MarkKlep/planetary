{
  "name": "backend",
  "version": "1.0.0",
  "description": "Chat backend for Planetary: proxies Ollama and streams NDJSON.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.4",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
