{
  "name": "planetary",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:planetary": "vite --port 5173 --strictPort",
    "setup:chat": "npm --prefix backend install",
    "dev:chat:server": "cross-env PORT=3003 npm --prefix backend run dev",
    "dev:chat": "concurrently -n planetary,chat-api -c cyan,green \"npm run dev:planetary\" \"npm run dev:chat:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "echo \"Error: no test specified\" && exit 1"
