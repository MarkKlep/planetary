    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "sass-embedded": "^1.97.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "dependencies": {
